# ==========================================
# VENTUS TAROT AI - CẤU HÌNH MÔI TRƯỜNG
# ==========================================

# 1. Supabase Postgres & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Base URL & Tokens
NEXT_PUBLIC_SITE_URL=http://localhost:3000
READING_TOKEN_SECRET=your-32-character-secret-key-for-hmac-tokens

# 3. AI Providers (Chọn 1 trong 3: gemini / anthropic / openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Hoặc Claude / OpenAI:
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# 4. Triage Moderation AI (Lớp 0 Kiểm duyệt câu hỏi)
TRIAGE_AI_PROVIDER=gemini
TRIAGE_GEMINI_API_KEY=your-gemini-api-key
TRIAGE_GEMINI_MODEL=gemini-2.5-flash

# 5. Cổng Thanh Toán VietQR / PayOS
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# 6. Cron & Background Tasks
CRON_SECRET=your-cron-secret-key-min-16-chars
